# Neon Postgres — get these from your Neon project dashboard (Connection Details).
# DATABASE_URL: pooled connection (pgbouncer) — used by the app at runtime.
# Required in every environment, including Vercel: every page does a Prisma
# query, so the site 500s on load without this set.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/sultan_mauritius?sslmode=verify-full"
# DIRECT_URL: direct (non-pooled) connection — used by the Prisma CLI for
# migrations (`prisma migrate`, `prisma studio`) and prisma.config.ts. Not
# read by the deployed app itself, only needed where you run migrations from.
DIRECT_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/sultan_mauritius?sslmode=verify-full"

# /admin login. Required in every environment — the admin panel 500s
# without ADMIN_SESSION_SECRET set. Rotating ADMIN_SESSION_SECRET instantly
# invalidates every existing admin session cookie.
ADMIN_USERNAME="choose-an-admin-username"
ADMIN_PASSWORD="choose-a-strong-admin-password"
ADMIN_SESSION_SECRET="generate-a-random-secret-eg-openssl-rand-hex-32"

# Order status emails (src/lib/email.ts), sent via Resend. Without
# RESEND_API_KEY, order status emails are skipped (logged, not sent) —
# they don't block placing an order.
RESEND_API_KEY="get-an-api-key-from-resend.com"
# Optional: only needed once a sending domain is verified in Resend.
# Until then, mail goes out from Resend's shared onboarding@resend.dev
# address, which only delivers to the Resend account's own verified email
# — every other recipient silently fails to receive it.
EMAIL_FROM="Sultan Mauritius <orders@sultanmauritius.mu>"
# Optional: where the "new order" admin notification email is sent.
# Defaults to hello@sultan.mu if unset.
ADMIN_NOTIFICATION_EMAIL="hello@sultan.mu"

# Admin-uploaded product photos (src/app/actions/inventory.ts's createProduct)
# go to Vercel Blob. Locally, `vercel env pull` after enabling a Blob store
# on the Vercel project fills this in; on Vercel itself it's set automatically
# once the store is connected to the project, no manual copy needed. Free on
# the Hobby plan.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
