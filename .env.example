# Neon Postgres — get these from your Neon project dashboard (Connection Details).
# DATABASE_URL: pooled connection (pgbouncer) — used by the app at runtime.
# Required in every environment, including Vercel: every page does a Prisma
# query, so the site 500s on load without this set.
DATABASE_URL="postgresql://user:password@ep-example-123456-pooler.us-east-2.aws.neon.tech/sultan_mauritius?sslmode=verify-full"
# DIRECT_URL: direct (non-pooled) connection — used by the Prisma CLI for
# migrations (`prisma migrate`, `prisma studio`) and prisma.config.ts. Not
# read by the deployed app itself, only needed where you run migrations from.
DIRECT_URL="postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/sultan_mauritius?sslmode=verify-full"

# Sanity CMS webhook signature verification (src/app/api/sanity/*/route.ts).
# Required for the Studio -> Postgres content sync to work; the rest of the
# site renders fine without it (falls back to messages/*.json copy).
# Set the same value when creating the webhooks in Sanity Manage.
SANITY_WEBHOOK_SECRET="generate-a-random-secret-and-reuse-it-in-sanity-manage"

# Only needed if you run the one-off scripts/sanity-*.js scripts from this
# environment (Studio backfill/seed), not read by the deployed app.
SANITY_PROJECT_ID="ftdxoig2"
SANITY_DATASET="production"
SANITY_API_KEY="get-a-token-from-sanity-manage-api-tokens"
